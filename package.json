{
  "name": "apefest-arrival",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate && next build",
    "start": "next start",
    "lint": "eslint",
    "validate": "vitest run tests/content.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "stage": "node scripts/stage.mjs",
    "stage:check": "node scripts/stage.mjs --dry-run"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
